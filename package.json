{
  "name": "@krzysztofkobra/orca-mcp",
  "version": "0.1.1",
  "description": "MCP server for Orca: start, watch and steer coding agents running in Orca from any MCP client (Hermes Agent, Claude Code, Codex).",
  "license": "MIT",
  "author": "Krzysztof Kobra",
  "type": "module",
  "bin": {
    "orca-mcp": "dist/server.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "orca",
    "coding-agents",
    "claude-code",
    "codex",
    "hermes"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/server.js",
    "prepublishOnly": "pnpm build",
    "prepare": "pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krzysztofkobra/orca-mcp.git"
  }
}
